# RTSP video settings; 0 leaves a setting as it is. The camera restarts the stream.
int32 width                   # with height: 2592x1944, 1920x1080, 1280x720, 720x480, 640x480
int32 height
int32 fps                     # 1..30
int32 bit_rate                # kbps: 4096, 2048, 1024, 512
int32 rtsp_port
---
bool success
string message
VideoConfig config            # read back from the camera
